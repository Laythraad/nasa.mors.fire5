# Local application settings
AEGIS_PORT=8000
AEGIS_CORS_ORIGINS=
AEGIS_ACCESS_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
# Persistent SQLite database and raw-object archive live in the Docker volume.
AEGIS_DB_PATH=/app/data/aegis.db
AEGIS_RAW_OBJECT_DIR=/app/data/raw

# Optional: NASA FIRMS MAP_KEY for bounded live area requests.
# Do not commit real credentials or put API keys into image build arguments.
NASA_FIRMS_MAP_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
NASA_API_KEY=
EARTHDATA_TOKEN=
